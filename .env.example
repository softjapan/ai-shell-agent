# Copy to .env and fill in the key for the provider you use.
# Environment variables always take precedence over this file.
# Never commit a real .env; it is gitignored.

# Default provider: google or openai. Overridden by --provider.
AI_SHELL_AGENT_PROVIDER=

# Google Gemini (default provider)
GEMINI_API_KEY=

# OpenAI (use with: --provider openai)
OPENAI_API_KEY=
